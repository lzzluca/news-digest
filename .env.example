# Copy to .env (git-ignored) and fill in. Never commit .env.
# FreshRSS seen from inside the Docker network: http://<freshrss service name>/api/greader.php
FRESHRSS_API_URL=http://freshrss/api/greader.php
FRESHRSS_USER=luca
# FreshRSS > Settings > Profile > API password (not your login password)
FRESHRSS_API_PASSWORD=
# From `claude setup-token`, run on a machine with a browser
CLAUDE_CODE_OAUTH_TOKEN=
OUT_DIR=/workspace/out
# YouTube cookies of the dedicated account, exported in Netscape format (see README)
YTDLP_COOKIES_FILE=/run/secrets/youtube-cookies.txt
